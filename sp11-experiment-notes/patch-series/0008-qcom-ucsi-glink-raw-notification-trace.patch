From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 8/8] usb: typec: ucsi: glink: trace raw notifications

Trace UCSI GLINK messages before dispatch so firmware notifications can be
distinguished from parser or UCSI state-machine failures. Diagnostic only.

---
 drivers/usb/typec/ucsi/ucsi_glink.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/typec/ucsi/ucsi_glink.c b/drivers/usb/typec/ucsi/ucsi_glink.c
index 000000000000..000000000000 100644
--- a/drivers/usb/typec/ucsi/ucsi_glink.c
+++ b/drivers/usb/typec/ucsi/ucsi_glink.c
@@ -332,8 +332,14 @@ static void pmic_glink_ucsi_callback(const void *data, size_t len, void *priv)
 {
 	struct pmic_glink_ucsi *ucsi = priv;
 	const struct pmic_glink_hdr *hdr = data;
+	u32 opcode = le32_to_cpu(hdr->opcode);
+
+	dev_info(ucsi->dev,
+		 "raw UCSI GLINK message owner=%u type=%u opcode=0x%08x len=%zu\n",
+		 le32_to_cpu(hdr->owner), le32_to_cpu(hdr->type), opcode, len);
 
-	switch (le32_to_cpu(hdr->opcode)) {
+	switch (opcode) {
-- 
