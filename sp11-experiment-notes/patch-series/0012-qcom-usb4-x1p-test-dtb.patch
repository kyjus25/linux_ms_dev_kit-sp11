From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 12/12] arm64: dts: qcom: add isolated X1P USB4 activation DTB

Add the public X1E-derived host-router resource map disabled by default and
provide a separate X1P LCD test DTB that explicitly opts into the gated NHI
activation path. The normal Denali DTB is not changed to activate the router.

--- a/arch/arm64/boot/dts/qcom/hamoa.dtsi
+++ b/arch/arm64/boot/dts/qcom/hamoa.dtsi
@@ -3141,6 +3141,81 @@
 		 * The resource map is from Qualcomm's public X1E binding RFC and
 		 * remains unverified for the X1P variant.
 		 */
+		usb4_hr0: usb4-host-router@15600000 {
+			compatible = "qcom,x1e80100-usb4-hr", "qcom,usb4-hr";
+
+			reg = <0 0x15600000 0 0x8000>,
+			      <0 0x15608000 0 0x70>,
+			      <0 0x15608070 0 0x500>,
+			      <0 0x1560d000 0 0x1000>,
+			      <0 0x15612000 0 0x1000>,
+			      <0 0x15613000 0 0xe000>,
+			      <0 0x15621000 0 0x2000>,
+			      <0 0x15623000 0 0x2000>,
+			      <0 0x1563f000 0 0x40000>,
+			      <0 0x1567f000 0 0x1000>,
+			      <0 0x15680000 0 0x1000>,
+			      <0 0x15681000 0 0x1000>,
+			      <0 0x15682000 0 0x1000>,
+			      <0 0x15683000 0 0x1000>,
+			      <0 0x15685000 0 0x1000>,
+			      <0 0x15686000 0 0x1000>,
+			      <0 0x15688000 0 0x1000>;
+			reg-names = "router", "router_config", "tmu_config",
+					 "port_group", "sideband", "uc_ram", "uc_per",
+					 "uc_mbox", "nhi", "cfg", "debug", "usbap_config",
+					 "pcieap_config", "dpap0_aux", "dpap0_config",
+					 "dpap1_aux", "dpap1_config";
+
+			interrupts = <GIC_SPI 472 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 579 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "ring", "fw";
+
+			clocks = <&gcc GCC_USB4_0_SYS_CLK>,
+				 <&gcc GCC_USB4_0_TMU_CLK>,
+				 <&gcc GCC_USB4_0_CFG_AHB_CLK>,
+				 <&gcc GCC_AGGRE_USB4_0_AXI_CLK>,
+				 <&gcc GCC_USB4_0_MASTER_CLK>,
+				 <&gcc GCC_USB4_0_PHY_RX0_CLK>,
+				 <&gcc GCC_USB4_0_PHY_RX1_CLK>,
+				 <&gcc GCC_USB4_0_SB_IF_CLK>,
+				 <&gcc GCC_USB4_0_DP0_CLK>,
+				 <&gcc GCC_USB4_0_DP1_CLK>;
+			clock-names = "sys", "tmu", "ahb", "axi", "master",
+				      "phy_rx0", "phy_rx1", "sb", "dp0", "dp1";
+
+			resets = <&gcc GCC_USB4_0_BCR>,
+				 <&gcc GCC_USB4_0_DP0_PHY_PRIM_BCR>,
+				 <&gcc GCC_USB4_0_MISC_USB4_SYS_BCR>,
+				 <&gcc GCC_USB4_0_MISC_RX_CLK_0_BCR>,
+				 <&gcc GCC_USB4_0_MISC_RX_CLK_1_BCR>,
+				 <&gcc GCC_USB4_0_MISC_USB_PIPE_BCR>,
+				 <&gcc GCC_USB4_0_MISC_PCIE_PIPE_BCR>,
+				 <&gcc GCC_USB4_0_MISC_TMU_BCR>,
+				 <&gcc GCC_USB4_0_MISC_SB_IF_BCR>,
+				 <&gcc GCC_USB4_0_MISC_HIA_MSTR_BCR>,
+				 <&gcc GCC_USB4_0_MISC_AHB_BCR>,
+				 <&gcc GCC_USB4_0_MISC_DP0_MAX_PCLK_BCR>,
+				 <&gcc GCC_USB4_0_MISC_DP1_MAX_PCLK_BCR>;
+			reset-names = "core", "phy_nocsr", "sys", "rx0", "rx1",
+				      "usb_pipe", "pcie_pipe", "tmu", "sideband_iface",
+				      "hia_master", "ahb", "dp0", "dp1";
+
+			power-domains = <&gcc GCC_USB4_0_GDSC>;
+			phys = <&usb_1_ss0_qmpphy QMP_USB43DP_USB4_PHY>;
+			phy-names = "usb4";
+
+			interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+					 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ACTIVE_ONLY>,
+					<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+					 &config_noc SLAVE_USB4_0 QCOM_ICC_TAG_ACTIVE_ONLY>;
+			interconnect-names = "usb4-ddr", "apps-usb4";
+
+			iommus = <&apps_smmu 0x1440 0x0>;
+			mode-switch;
+			wakeup-source;
+			status = "disabled";
+		};
 
 		mmss_noc: interconnect@1780000 {
 			compatible = "qcom,x1e80100-mmss-noc";

diff --git a/arch/arm64/boot/dts/qcom/x1p64100-microsoft-denali-usb4-test.dts b/arch/arm64/boot/dts/qcom/x1p64100-microsoft-denali-usb4-test.dts
new file mode 100644
index 000000000000..b963ef12932e
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1p64100-microsoft-denali-usb4-test.dts
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Isolated X1P LCD USB4 activation experiment. */
+
+/dts-v1/;
+
+#include "x1p64100-microsoft-denali.dts"
+
+&usb4_hr0 {
+	status = "okay";
+	qcom,nhi-activate;
+};

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index d92148427b85..657c76278f99 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -490,3 +490,4 @@ x1p64100-acer-swift-sf14-11-el2-dtbs	:= x1p64100-acer-swift-sf14-11.dtb x1-el2.d
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p64100-acer-swift-sf14-11.dtb x1p64100-acer-swift-sf14-11-el2.dtb
 x1p64100-microsoft-denali-el2-dtbs	:= x1p64100-microsoft-denali.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p64100-microsoft-denali.dtb x1p64100-microsoft-denali-el2.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= x1p64100-microsoft-denali-usb4-test.dtb
