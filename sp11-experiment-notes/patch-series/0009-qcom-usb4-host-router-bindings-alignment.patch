From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH 9/9] thunderbolt: qcom: align dormant validator with binding

Match the public Qualcomm binding by including the phy_nocsr reset and the
generic qcom,usb4-hr compatible fallback. This patch remains validation-only.

---
 drivers/thunderbolt/qcom_usb4_hr.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/thunderbolt/qcom_usb4_hr.c b/drivers/thunderbolt/qcom_usb4_hr.c
index 000000000000..000000000000 100644
--- a/drivers/thunderbolt/qcom_usb4_hr.c
+++ b/drivers/thunderbolt/qcom_usb4_hr.c
@@ -32,7 +32,7 @@ static const char * const qcom_usb4_hr_clocks[] = {
 };
 
 static const char * const qcom_usb4_hr_resets[] = {
-	"core", "sys", "rx0", "rx1", "usb_pipe",
+	"core", "phy_nocsr", "sys", "rx0", "rx1", "usb_pipe",
 	"pcie_pipe", "tmu", "sideband_iface", "hia_master", "ahb",
 	"dp0", "dp1",
 };
@@ -89,6 +89,7 @@ static int qcom_usb4_hr_probe(struct platform_device *pdev)
 
 static const struct of_device_id qcom_usb4_hr_of_match[] = {
 	{ .compatible = "qcom,x1e80100-usb4-hr" },
+	{ .compatible = "qcom,usb4-hr" },
 	{ }
 };
