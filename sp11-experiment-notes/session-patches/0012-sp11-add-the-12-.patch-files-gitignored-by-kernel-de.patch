+Subject: [PATCH 12/12] arm64: dts: qcom: add isolated X1P USB4 activation DTB
+
+Add the public X1E-derived host-router resource map disabled by default and
+provide a separate X1P LCD test DTB that explicitly opts into the gated NHI
+activation path. The normal Denali DTB is not changed to activate the router.
+
+--- a/arch/arm64/boot/dts/qcom/hamoa.dtsi
++++ b/arch/arm64/boot/dts/qcom/hamoa.dtsi
+@@ -3141,6 +3141,81 @@
+ 		 * The resource map is from Qualcomm's public X1E binding RFC and
+ 		 * remains unverified for the X1P variant.
+ 		 */
++		usb4_hr0: usb4-host-router@15600000 {
++			compatible = "qcom,x1e80100-usb4-hr", "qcom,usb4-hr";
++
++			reg = <0 0x15600000 0 0x8000>,
++			      <0 0x15608000 0 0x70>,
++			      <0 0x15608070 0 0x500>,
++			      <0 0x1560d000 0 0x1000>,
++			      <0 0x15612000 0 0x1000>,
++			      <0 0x15613000 0 0xe000>,
++			      <0 0x15621000 0 0x2000>,
++			      <0 0x15623000 0 0x2000>,
++			      <0 0x1563f000 0 0x40000>,
++			      <0 0x1567f000 0 0x1000>,
++			      <0 0x15680000 0 0x1000>,
++			      <0 0x15681000 0 0x1000>,
++			      <0 0x15682000 0 0x1000>,
++			      <0 0x15683000 0 0x1000>,
++			      <0 0x15685000 0 0x1000>,
++			      <0 0x15686000 0 0x1000>,
++			      <0 0x15688000 0 0x1000>;
++			reg-names = "router", "router_config", "tmu_config",
++					 "port_group", "sideband", "uc_ram", "uc_per",
++					 "uc_mbox", "nhi", "cfg", "debug", "usbap_config",
++					 "pcieap_config", "dpap0_aux", "dpap0_config",
++					 "dpap1_aux", "dpap1_config";
++
++			interrupts = <GIC_SPI 472 IRQ_TYPE_LEVEL_HIGH>,
++				     <GIC_SPI 579 IRQ_TYPE_LEVEL_HIGH>;
++			interrupt-names = "ring", "fw";
++
++			clocks = <&gcc GCC_USB4_0_SYS_CLK>,
++				 <&gcc GCC_USB4_0_TMU_CLK>,
++				 <&gcc GCC_USB4_0_CFG_AHB_CLK>,
++				 <&gcc GCC_AGGRE_USB4_0_AXI_CLK>,
++				 <&gcc GCC_USB4_0_MASTER_CLK>,
++				 <&gcc GCC_USB4_0_PHY_RX0_CLK>,
++				 <&gcc GCC_USB4_0_PHY_RX1_CLK>,
++				 <&gcc GCC_USB4_0_SB_IF_CLK>,
++				 <&gcc GCC_USB4_0_DP0_CLK>,
++				 <&gcc GCC_USB4_0_DP1_CLK>;
++			clock-names = "sys", "tmu", "ahb", "axi", "master",
