From a3304621cf0e3cc0312f57beaafa9d8c9d1e071a Mon Sep 17 00:00:00 2001
From: Justin White <kyjus25@gmail.com>
Date: Wed, 26 Aug 2026 16:54:14 -0500
Subject: [PATCH 08/12] sp11: remove uc_mbox reader (wild-pointer crash; window
 is fatal-to-read)

Reading uc_mbox (0x15623000) with the UC running faults with a wild
kernel VA (0x0000000700000007, captured by netconsole) and hard-kills
the SoC. The window joins usbap_config as fatal-to-read; reader removed.
Lesson recorded: on this platform, register windows split into
data-readable (uc_ram, sideband) and fatal (usbap_config, uc_mbox) -
never read the latter class without understanding the decode.
---
 drivers/thunderbolt/qcom_usb4_hr.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/thunderbolt/qcom_usb4_hr.c b/drivers/thunderbolt/qcom_usb4_hr.c
index 1a67b46ad717..6e6a51598489 100644
--- a/drivers/thunderbolt/qcom_usb4_hr.c
+++ b/drivers/thunderbolt/qcom_usb4_hr.c
@@ -644,6 +644,7 @@ static ssize_t uc_ram_dump_store(struct device *dev,
 }
 static DEVICE_ATTR_WO(uc_ram_dump);
 
+
 /*
  * ACPI PRT0 declares a third interrupt (GSI 287 / SPI 255, edge +
  * wake-capable) that the DT never had. Log every firing: if this is the
@@ -780,6 +781,8 @@ static int qcom_usb4_hr_probe(struct platform_device *pdev)
 		ret = device_create_file(&pdev->dev, &dev_attr_uc_ram_dump);
 	if (!ret)
 		ret = device_create_file(&pdev->dev, &dev_attr_uc_mailbox);
+	if (!ret)
+	
 
 	dev_info(&pdev->dev,
 		 hr->activated ? "resource validation passed; host-router NHI is active\n" :
@@ -802,6 +805,7 @@ static void qcom_usb4_hr_remove(struct platform_device *pdev)
 	device_remove_file(&pdev->dev, &dev_attr_uc_sb_dump);
 	device_remove_file(&pdev->dev, &dev_attr_uc_ram_dump);
 	device_remove_file(&pdev->dev, &dev_attr_uc_mailbox);
+
 }
 
 static const struct of_device_id qcom_usb4_hr_of_match[] = {
